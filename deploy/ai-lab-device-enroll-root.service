[Unit]
Description=AI Lab Gateway restricted SSH enrollment (fixed root operations)
After=network-online.target ai-lab-device-code.service
Wants=network-online.target
Requires=ai-lab-device-code.service

[Service]
Type=oneshot
User=root
Group=root
Environment=PYTHONPATH=/opt/ai-lab-gateway/src
ExecStart=/usr/bin/python3 /usr/local/libexec/ai-lab-device-enroll-root
TimeoutStartSec=30
UMask=0077
# Tested against the actual Oracle OCI/systemd host:
# This worker must drop from root to the unprivileged gateway UID for
# independent SSH key and target-connection verification. On this kernel,
# PrivateDevices, ProtectKernelModules/Tunables, ProtectClock,
# LockPersonality, RestrictAddressFamilies, SystemCallArchitectures and
# RestrictSUIDSGID each deny setresuid even for a downward transition.
# Keep the independently validated compatible sandbox below.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ReadWritePaths=/etc/ai-lab-gateway /var/lib/ai-lab-gateway/.ssh /var/lib/ai-lab-tunnel/.ssh /var/lib/ai-lab-root-provision
InaccessiblePaths=/etc/ai-lab-approval /var/lib/ai-lab-approval /var/lib/ai-lab-privilege-broker
