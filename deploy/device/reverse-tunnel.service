[Unit]
Description=AI Lab Gateway reverse SSH tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ai-gateway
Group=ai-gateway
ExecStart=/usr/bin/ssh -NT \
    -i /home/ai-gateway/.ssh/tunnel_ed25519 \
    -o BatchMode=yes \
    -o IdentitiesOnly=yes \
    -o StrictHostKeyChecking=yes \
    -o ExitOnForwardFailure=yes \
    -o ServerAliveInterval=30 \
    -o ServerAliveCountMax=3 \
    -R 127.0.0.1:10001:127.0.0.1:22 \
    tunnel@gateway.debasti.com
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
