# Copy to protected runtime config outside Git, never commit real values.
LITE_BASE_URL=https://ai-gateway-lite.debasti.com
LITE_OAUTH_ISSUER=https://YOUR_TENANT.auth0.com/
LITE_OAUTH_AUDIENCE=https://ai-gateway-lite.debasti.com/mcp
LITE_OAUTH_JWKS_URL=https://YOUR_TENANT.auth0.com/.well-known/jwks.json
# Separate Auth0 Regular Web Application, not the ChatGPT client.
LITE_WEB_CLIENT_ID=SET_OUTSIDE_GIT
LITE_WEB_CLIENT_SECRET=SET_OUTSIDE_GIT
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
LITE_SESSION_SECRET=SET_OUTSIDE_GIT
# Stable Auth0 subject ID(s), comma separated; never emails.
LITE_ADMIN_SUBJECTS=REPLACE_WITH_REAL_SUB
LITE_DATABASE=/var/lib/ai-lab-gateway-lite/lite.sqlite3
LITE_AUDIT_LOG=/var/lib/ai-lab-gateway-lite/audit.jsonl
LITE_SSH_KEY_DIR=/var/lib/ai-lab-gateway-lite/keys
LITE_SSH_KNOWN_HOSTS=/var/lib/ai-lab-gateway-lite/known_hosts
# Replace with the actual WireGuard private CIDRs.
LITE_ALLOWED_SSH_CIDRS=10.200.0.0/24
