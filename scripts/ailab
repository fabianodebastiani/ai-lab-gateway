#!/usr/bin/env python3
"""Local, non-root AI Lab reverse-SSH connection manager (experimental v1).

The user-managed tunnel is independent of privileged operation execution.
Requires a previously APPROVED, locally pinned device-code pairing. Does
NOT contact an enrollment endpoint, run sudo, modify sshd, or grant root.
Run locally as the paired ai-gateway account; installation/wrapper for
the human's ordinary login is a separate, explicitly authorized step.
"""
from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys

DEVICE_ID = re.compile(r"[a-z][a-z0-9-]{2,47}\Z")
PREFIX = "ai-lab-device-"
GATEWAY = "gateway.debasti.com"
KNOWN_USER = "ai-gateway"


def private_file(path: Path, *, directory: bool = False) -> None:
    st = path.lstat()  # not stat(): do not follow untrusted symlinks
    expected = stat.S_ISDIR if directory else stat.S_ISREG
    if (not expected(st.st_mode) or st.st_uid != os.geteuid()
            or stat.S_IMODE(st.st_mode) != (0o700 if directory else 0o600)):
        raise PermissionError("untrusted AI Lab file/owner/mode: " + str(path))


def device_state() -> tuple[Path, str, str]:
    if os.geteuid() == 0:
        raise PermissionError("ailab commands must not run as root")
    home = Path.home()
    # Initial release intentionally matches the live 2026-10-16 paired
    # Ubuntu setup. Do not target another account or arbitrary system unit.
    if str(home) != "/home/ai-gateway":
        raise PermissionError("run as the already paired ai-gateway account")
    base = home / ".ssh"
    state = base / "ai-lab-device-code"
    private_file(base, directory=True)
    private_file(state, directory=True)
    identity = state / "device-id"
    private_file(identity)
    device_id = identity.read_text(encoding="ascii").strip()
    if not DEVICE_ID.fullmatch(device_id):
        raise PermissionError("invalid paired device identifier")
    return state, device_id, PREFIX + device_id + ".service"


def run(*argv: str, timeout: int = 20) -> subprocess.CompletedProcess:
    return subprocess.run(argv, capture_output=True, text=True,
                          timeout=timeout, check=False)


def systemd(*argv: str) -> None:
    result = run("systemctl", "--user", *argv)
    if result.returncode:
        raise RuntimeError("systemd user operation failed (" +
                           str(result.returncode) + "): " +
                           result.stderr.strip()[:250])


def details(unit: str) -> dict[str, str]:
    result = run("systemctl", "--user", "show", "--no-pager",
                 "--property=LoadState,ActiveState,UnitFileState,FragmentPath", unit)
    if result.returncode:
        raise RuntimeError("cannot query user tunnel service")
    fields = {}
    for line in result.stdout.splitlines():
        k, sep, v = line.partition("=")
        if sep and k in {"LoadState", "ActiveState", "UnitFileState", "FragmentPath"}:
            fields[k] = v
    if fields.get("ActiveState", "inactive") not in {
        "active", "inactive", "activating", "deactivating", "failed"
    }:
        raise RuntimeError("invalid tunnel service state")
    return fields


def verified_offer(state: Path, device_id: str) -> tuple[dict, Path, Path]:
    """Re-read a single committed local pairing offer, never a new URL."""
    matches = []
    for candidate in state.glob("candidate-*/offer.json"):
        parent = candidate.parent
        private_file(parent, directory=True)
        private_file(candidate)
        data = json.loads(candidate.read_text(encoding="utf-8"))
        if data.get("device_id") == device_id:
            matches.append(data)
    if len(matches) != 1:
        raise PermissionError("exactly one approved local SSH offer required")
    offer = matches[0]
    expected = {
        "device_id": device_id, "access_mode": "restricted",
        "management_user": KNOWN_USER,
        "gateway_host": GATEWAY, "gateway_ssh_port": 22,
        "gateway_tunnel_user": "tunnel", "reverse_listen_host": "127.0.0.1",
        "persistent": False,  # validated first-release pairing client
    }
    if any(type(offer.get(k)) is not type(v) or offer[k] != v
           for k, v in expected.items()):
        raise PermissionError("SSH offer does not match local approved configuration")
    port = offer.get("reverse_listen_port")
    if type(port) is not int or not 11000 <= port <= 11999:
        raise PermissionError("invalid assigned device reverse SSH port")
    pin = state / "trusted-gateway-known_hosts"
    key = state / "tunnel-ed25519"
    private_file(pin)
    private_file(key)
    gateway_key = offer.get("gateway_ssh_host_key")
    mgmt_key = offer.get("gateway_management_public_key")
    if not all(isinstance(k, str) and k.startswith("ssh-ed25519 ")
               and len(k) < 1024 and "\n" not in k for k in (gateway_key, mgmt_key)):
        raise PermissionError("missing pinned SSH public identities")
    if pin.read_text(encoding="ascii") != GATEWAY + " " + gateway_key + "\n":
        raise PermissionError("Gateway pin does not match verified pairing offer")
    auth = Path.home() / ".ssh" / "authorized_keys"
    private_file(auth)
    expected_key = mgmt_key.split()[:2]
    if expected_key not in [x.split()[:2] for x in auth.read_text(encoding="ascii").splitlines()]:
        raise PermissionError("Gateway management key is not locally installed")
    return offer, key, pin


def ssh_argv(offer: dict, key: Path, pin: Path) -> list[str]:
    return ["/usr/bin/ssh", "-N", "-T", "-i", str(key),
            "-o", "IdentitiesOnly=yes", "-o", "BatchMode=yes",
            "-o", "StrictHostKeyChecking=yes", "-o", "ExitOnForwardFailure=yes",
            "-o", "ServerAliveInterval=30", "-o", "ServerAliveCountMax=3",
            "-o", "UserKnownHostsFile=" + str(pin),
            "-R", "127.0.0.1:" + str(offer["reverse_listen_port"]) + ":127.0.0.1:22",
            "tunnel@" + GATEWAY]


def stable_unit(ssh: list[str]) -> str:
    # All arguments originate from fixed strings or already-validated
    # paths/port/hostname. Fail closed if future input includes directives.
    if any(not re.fullmatch(r"[/._a-zA-Z0-9@:=+-]+", part) for part in ssh):
        raise PermissionError("invalid systemd command component")
    return ("[Unit]\nDescription=AI Lab Gateway paired reverse SSH tunnel\n"
            "Wants=network-online.target\nAfter=network-online.target\n\n"
            "[Service]\nType=simple\nExecStart=" + " ".join(ssh) + "\n"
            "Restart=always\nRestartSec=5\n\n"
            "[Install]\nWantedBy=default.target\n")


def unit_file(unit: str, *, create_dir: bool = False) -> Path:
    parent = Path.home() / ".config"
    folder = parent / "systemd" / "user"
    if create_dir:
        for path in (parent, parent / "systemd", folder):
            if not path.exists() and not path.is_symlink():
                path.mkdir(mode=0o700)
            private_file(path, directory=True)
    return folder / unit


def start_transient(unit: str, ssh: list[str]) -> None:
    result = run("systemd-run", "--user", "--collect",
                 "--unit=" + unit.removesuffix(".service"),
                 "--property=Restart=on-failure", "--property=RestartSec=5s",
                 *ssh, timeout=25)
    if result.returncode:
        raise RuntimeError("could not start reverse SSH tunnel: " +
                           result.stderr.strip()[:250])


def status(unit: str) -> str:
    d = details(unit)
    kind = d.get("UnitFileState", "unknown")
    active = d.get("ActiveState", "inactive")
    connected = active in {"active", "activating"}
    if kind in {"enabled", "enabled-runtime"}:
        persistent = "on"
    elif kind in {"disabled", "transient", "not-found"}:
        persistent = "off"
    else:
        persistent = "unknown"
    return ("tunnel=" + unit + "\n"
            "connected=" + ("yes" if connected else "no") + "\n"
            "persistent=" + persistent + "\n"
            "unit_type=" + kind)


def act(action: str, preference: str | None = None) -> str:
    state, device_id, unit = device_state()
    if action == "status":
        return status(unit)
    if action == "disconnect":
        if details(unit).get("LoadState") == "loaded":
            systemd("stop", unit)
        return status(unit)
    if action == "persistent" and preference == "off":
        path = unit_file(unit)
        if path.exists() or path.is_symlink():
            systemd("disable", unit)
        return status(unit)
    offer, key, pin = verified_offer(state, device_id)
    ssh = ssh_argv(offer, key, pin)
    path = unit_file(unit)
    if path.exists() or path.is_symlink():
        private_file(path)
        if path.read_text(encoding="utf-8") != stable_unit(ssh):
            raise PermissionError("existing systemd unit differs from trusted configuration")
    if action == "connect":
        if details(unit).get("ActiveState") == "active":
            return status(unit)
        if path.exists():
            systemd("start", unit)
        else:
            start_transient(unit, ssh)
        return status(unit)
    if action == "persistent" and preference == "on":
        # The initial SSH pairing creates a *transient* unit. Safely stage
        # the stable user unit and change over while working LOCALLY, with
        # a rollback that tries to restore the previous transient tunnel.
        had_file = path.exists()
        was_active = details(unit).get("ActiveState") == "active"
        was_transient = details(unit).get("UnitFileState") == "transient"
        if not had_file:
            path = unit_file(unit, create_dir=True)
            fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
            with os.fdopen(fd, "w", encoding="utf-8") as stream:
                stream.write(stable_unit(ssh))
                stream.flush()
                os.fsync(stream.fileno())
        try:
            if was_transient:
                systemd("stop", unit)
            systemd("daemon-reload")
            systemd("enable", "--now", unit)
        except BaseException:
            if not had_file:
                run("systemctl", "--user", "disable", unit)
                path.unlink(missing_ok=True)
                run("systemctl", "--user", "daemon-reload")
                if was_active and was_transient:
                    try:
                        start_transient(unit, ssh)
                    except (OSError, RuntimeError):
                        pass
            raise
        return status(unit)
    raise ValueError("unsupported local connection action")


def main() -> int:
    parser = argparse.ArgumentParser(prog="ailab", description="AI Lab local SSH connection control")
    subs = parser.add_subparsers(dest="action", required=True)
    for command in ("status", "connect", "disconnect"):
        subs.add_parser(command)
    persistent = subs.add_parser("persistent")
    persistent.add_argument("preference", choices=("on", "off"))
    args = parser.parse_args()
    try:
        print(act(args.action, getattr(args, "preference", None)))
        return 0
    except (OSError, ValueError, PermissionError, RuntimeError,
            subprocess.SubprocessError, KeyError, json.JSONDecodeError) as exc:
        print("AILAB_CONNECTION_DENIED: " + type(exc).__name__ + ": " + str(exc),
              file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
