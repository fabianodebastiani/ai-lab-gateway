# Public configuration only. Never commit real secrets.
AI_LAB_GATEWAY_ENV=development

# OAuth resource-server configuration. Replace with the selected provider's
# exact issuer/JWKS values when authentication is deployed.
AI_LAB_OAUTH_ISSUER=https://auth.example.invalid
AI_LAB_OAUTH_AUDIENCE=https://gateway.debasti.com
AI_LAB_OAUTH_JWKS_URL=https://auth.example.invalid/.well-known/jwks.json
AI_LAB_OAUTH_RESOURCE_METADATA_URL=https://gateway.debasti.com/.well-known/oauth-protected-resource
